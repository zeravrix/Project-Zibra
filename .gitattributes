# Normalize line endings across platforms
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.bmp binary
*.ttf binary
*.otf binary
*.zip binary
*.cbz binary
*.pdf binary

# GitHub Linguist overrides — keep the repository language bar 100% Rust
*.rs linguist-detectable=true
tools/** linguist-vendored
packaging/** linguist-vendored
installer/** linguist-vendored
distribution/** linguist-vendored
docs/** linguist-documentation
assets/** linguist-vendored
.github/** linguist-vendored
*.sh linguist-vendored
*.ps1 linguist-vendored
*.py linguist-vendored
*.c linguist-vendored
*.h linguist-vendored
*.iss linguist-vendored
*.spec linguist-vendored
*.xml linguist-vendored
*.yml linguist-vendored
*.yaml linguist-vendored
*.properties linguist-vendored
