{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZibraX",
  "version": "2.2.0",
  "identifier": "org.zeravrix.zibra",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ZibraX • Native Manga & Manhwa Reader",
        "url": "index.html",
        "width": 1240,
        "height": 780,
        "minWidth": 500,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#23212c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
